---
import { getCollection } from "astro:content";
import "./CardFan.css";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(p => ({ title: p.data.title, image: p.data.image, url: `/projects/${p.id}` }));
---
<section id="projects" class="fan">
  <div class="fan-sticky">
    <h2>PROJECTS</h2>
    <div class="stage" id="stage" aria-live="polite" data-projects={JSON.stringify(projects)}></div>
  </div>
</section>

<script>
  import "./cards.js";
</script>

<style is:global>
  .fan { height: calc(100vh + (max(var(--cards, 3), 3) - 1) * 60vh); }
  .fan-sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; mask-image: linear-gradient(to bottom, #000 70%, transparent 100%); }
  .fan-sticky h2 {
    position: relative;
    z-index: 2;
    padding-top: 12vh;
    text-align: center;
    font-size: clamp(2.5rem, 8vw, 6rem);
    letter-spacing: .05em;
  }
</style>
