<canvas id="island" aria-hidden="true"></canvas>
<svg id="hud" aria-hidden="true"><polyline id="hud-line" /><circle id="hud-dot" r="4" /><circle id="hud-ring" r="4" /><text id="hud-label"></text></svg>

<script>
  // three.js is heavy: fetch it once the page has painted and the browser is idle
  const start = () => import("./island-scene.ts");
  const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 600));
  if (document.readyState === "complete") idle(); else addEventListener("load", idle, { once: true });
</script>

<style is:global>
  #island { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; height: 100lvh; z-index: -1; pointer-events: none; opacity: 0; }
  #hud { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0;   /* under the project cards, which paint later in the page */  pointer-events: none; overflow: visible; opacity: 0; }
  #hud polyline { fill: none; stroke: var(--accent); stroke-width: 1.2; filter: drop-shadow(0 0 4px var(--accent)); }
  #hud circle { fill: var(--accent); filter: drop-shadow(0 0 6px var(--accent)); }
  #hud #hud-ring { fill: none; stroke: var(--accent); stroke-width: 1; transform-box: fill-box; transform-origin: center; animation: hud-ring 1.8s ease-out infinite; }
  #hud text { fill: var(--accent); font: 12px var(--mono); letter-spacing: .08em; text-transform: uppercase; text-shadow: 0 0 6px #000; }
  @keyframes hud-ring { from { transform: scale(1); opacity: .9; } to { transform: scale(4.5); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { #hud #hud-ring { animation: none; } }
  @media print { #island, #hud { display: none !important; } }
</style>
