---
import * as si from "simple-icons";
import { readFileSync } from "node:fs";
import { svgPathBbox } from "svg-path-bbox";
import cv from "../data/cv.json";

const icons = si as unknown as Record<string, { path: string }>;

// brand logos get a viewBox cropped to their drawing, so wide wordmarks
// (Cisco, VMware, Go) fill the tile instead of floating in a square;
// the small padding stops the bounding box clipping curved edges
const viewBox = (path: string) => {
  const [x0, y0, x1, y1] = svgPathBbox(path);
  const pad = 0.5;
  return `${x0 - pad} ${y0 - pad} ${x1 - x0 + pad * 2} ${y1 - y0 + pad * 2}`;
};

// stroke icons for skills that have no brand logo
const lucide = (name: string) =>
  readFileSync(`node_modules/lucide-static/icons/${name}.svg`, "utf8").replace(/^[\s\S]*?<svg[^>]*>|<\/svg>\s*$/g, "");
---
{cv.skills.map(g => (
  <div class="group reveal">
    <h3>{g.group}</h3>
    <ul>
      {g.items.map(item => {
        const icon = "icon" in item ? icons[item.icon] : undefined;
        const stroke = "lucide" in item ? lucide(item.lucide) : undefined;
        return (
          <li>
            {icon && <svg viewBox={viewBox(icon.path)} fill="currentColor" aria-hidden="true"><path d={icon.path} /></svg>}
            {stroke && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stroke} />}
            <span>{item.name}</span>
          </li>
        );
      })}
    </ul>
  </div>
))}

<style>
  .group { margin-bottom: 2rem; }
  h3 { font-size: .85rem; text-transform: uppercase; letter-spacing: .1em; opacity: .6; margin-bottom: .75rem; }
  ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr)); grid-auto-rows: 6rem; gap: .6rem; }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: .5rem;
    padding: .75rem .5rem .5rem;      /* every tile has the same height; icons and labels line up even when a name wraps */
    border: 1px solid rgba(127, 233, 201, .25);
    border-radius: 10px;
    background: rgba(127, 233, 201, .03);
    text-align: center;
    font-size: .8rem;
    transition: transform .3s, border-color .3s, background .3s, color .3s;
  }
  li svg { flex: none; height: 2.2rem; width: auto; max-width: 5.5rem; opacity: .9; transition: opacity .3s, color .3s; }
  li span { line-height: 1.3; }
  li:hover { transform: translateY(-4px); border-color: var(--accent); background: rgba(127, 233, 201, .08); color: var(--accent); }
  li:hover svg { opacity: 1; color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { li:hover { transform: none; } }
</style>
