---
import { excerpt, formatDate, hue, readingTime, type Post } from "../lib/posts";

interface Props { posts: Post[]; filter?: boolean }
const { posts, filter = false } = Astro.props;
const tags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---
{filter && tags.length > 0 && (
  <div class="filters" role="group" aria-label="Filter by tag">
    <button data-tag="" aria-pressed="true">All</button>
    {tags.map(t => <button data-tag={t} aria-pressed="false">{t}</button>)}
  </div>
)}

<ul class="posts" data-filter={filter || undefined}>
  {posts.map((p, i) => (
    <li class:list={["post", { featured: i === 0 }]} data-tags={p.data.tags.join(",")}>
      <a class="cover" href={`/blog/${p.id}`} tabindex="-1" aria-hidden="true">
        {p.data.cover
          ? <img src={p.data.cover} alt="" loading="lazy" />
          : <span class="gen" style={`--h:${hue(p.id)}`}></span>}
      </a>
      <div class="body">
        <p class="meta"><span>{formatDate(p.data.date)}</span><span>{readingTime(p)} min read</span></p>
        <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
        <p class="excerpt">{excerpt(p)}</p>
        {p.data.tags.length > 0 && (
          <ul class="tags">
            {p.data.tags.map(t => <li><a href={`/blog?tag=${encodeURIComponent(t)}`} data-tag={t}>{t}</a></li>)}
          </ul>
        )}
      </div>
    </li>
  ))}
</ul>

{filter && <p class="empty" hidden>No posts with this tag yet.</p>}

<script>
  const list = document.querySelector<HTMLElement>(".posts[data-filter]");
  if (list) {
    const items = [...list.querySelectorAll<HTMLElement>(".post")];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".filters button")];
    const empty = document.querySelector<HTMLElement>(".empty")!;

    const apply = (tag: string) => {
      let first = true;
      for (const li of items) {
        const show = !tag || li.dataset.tags!.split(",").includes(tag);
        li.hidden = !show;
        li.classList.toggle("featured", show && first);
        if (show) first = false;
      }
      empty.hidden = !first;
      buttons.forEach(b => b.setAttribute("aria-pressed", String(b.dataset.tag === tag)));
    };
    const select = (tag: string) => {
      apply(tag);
      history.replaceState(null, "", tag ? `?tag=${encodeURIComponent(tag)}` : location.pathname);
    };

    buttons.forEach(b => b.addEventListener("click", () => select(b.dataset.tag!)));
    list.addEventListener("click", e => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(".tags a");
      if (!a) return;
      e.preventDefault();
      select(a.dataset.tag!);
    });
    apply(new URLSearchParams(location.search).get("tag") ?? "");
  }
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0; }
  .filters button {
    font: inherit;
    font-size: .8rem;
    color: #fff;
    background: none;
    border: 1px solid rgba(127, 233, 201, .3);
    border-radius: 999px;
    padding: .2rem .8rem;
    cursor: pointer;
    transition: border-color .3s, color .3s, background .3s;
  }
  .filters button:hover { border-color: var(--accent); }
  .filters button[aria-pressed="true"] { background: var(--accent); color: #000; border-color: var(--accent); }

  .posts { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1.25rem; }
  .post { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .post[hidden] { display: none; }

  .cover, .gen, img { display: block; width: 100%; height: 100%; }
  .cover { overflow: hidden; border-radius: 10px; border: 1px solid rgba(127, 233, 201, .3); position: relative; }
  .cover img { object-fit: cover; }
  .gen {
    background: linear-gradient(135deg, hsl(var(--h) 55% 22%), hsl(calc(var(--h) + 60) 60% 10%));
  }
  .cover::after {
    content: "";
    position: absolute;
    inset: 0 0 -7px 0;
    pointer-events: none;
    background: repeating-linear-gradient(transparent 0, rgba(255, 255, 255, .1) 3.5px, transparent 7px);
    will-change: transform;
    animation: scan 1.4s linear infinite;
  }
  @keyframes scan { to { transform: translateY(-7px); } }
  @media (prefers-reduced-motion: reduce) { .cover::after { animation: none; } }

  .meta { display: flex; gap: 1rem; font-size: .8rem; opacity: .55; letter-spacing: .04em; }
  h3 { margin: .25rem 0 .5rem; font-size: 1.1rem; }
  h3 a { color: #fff; text-decoration: none; transition: color .3s; }
  h3 a:hover { color: var(--accent); }
  .excerpt { opacity: .75; font-size: .95rem; }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .75rem; }
  .tags a {
    font-size: .72rem;
    text-decoration: none;
    color: var(--accent);
    border: 1px solid rgba(127, 233, 201, .35);
    border-radius: 999px;
    padding: .05rem .6rem;
  }
  .tags a:hover { background: rgba(127, 233, 201, .12); }

  .post:not(.featured) { padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, .1); }
  .post:not(.featured) .cover, .post:not(.featured) .excerpt { display: none; }

  .post.featured .cover { aspect-ratio: 16 / 9; }
  .post.featured h3 { font-size: 1.6rem; }
  @media (min-width: 760px) {
    .post.featured { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 1.75rem; }
  }
  .empty { opacity: .6; }
</style>
