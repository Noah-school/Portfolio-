---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", p => !p.data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title}>
  <main class="page">
    <h1 class="post-title">{post.data.title}</h1>
    <p class="date">{post.data.date.toISOString().slice(0, 10)}</p>
    <article><Content /></article>
  </main>
</Base>

<style>
  .post-title { font-size: clamp(1.8rem, 5vw, 3rem); text-align: left; }
  .date { opacity: .6; margin-bottom: 2rem; }
  article :global(p), article :global(pre) { margin-bottom: 1rem; }
  article :global(code) { color: var(--accent); }
</style>
