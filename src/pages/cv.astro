---
import Base from "../layouts/Base.astro";
import Timeline from "../components/Timeline.astro";
import TechGrid from "../components/TechGrid.astro";
import { getCollection } from "astro:content";
import cv from "../data/cv.json";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Resume">
  <main class="page">
    <header class="intro">
      <figure class="portrait">
        <img src="/images/noah.jpg" alt={`Portrait of ${cv.name}`} width="600" height="800">
      </figure>
      <div>
        <h1>{cv.name}</h1>
        <p class="role">{cv.title}</p>
        <p>{cv.tagline} {cv.summary}</p>
        <p class="links">
          <a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
          <a href={cv.contact.github}>GitHub</a>
          <a href={cv.contact.linkedin}>LinkedIn</a>
        </p>
        <p class="no-print"><a class="download" href="/Noah-Verstraeten-Resume.pdf" download>Download PDF ↓</a></p>
      </div>
    </header>

    <p class="print-only">
      Website: portfolio.xenophon.be · LinkedIn: linkedin.com/in/noahverstraeten · GitHub: github.com/Noah-school
    </p>

    <div class="body">
      <div>
        <h2>Experience &amp; education</h2>
        <Timeline />

        <h2>Projects</h2>
        <ul class="projects">
          {projects.map(p => (
            <li>
              <h3><a href={`/projects/${p.id}`}>{p.data.title}</a></h3>
              <p>{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Skills</h2>
        <TechGrid />
      </div>
    </div>
  </main>
</Base>

<style>
  h2 { margin-top: 2.5rem; color: var(--accent); }
  .intro { display: grid; gap: 1.5rem; align-items: center; margin-top: 2rem; }
  @media (min-width: 700px) { .intro { grid-template-columns: 12rem 1fr; gap: 2rem; } }
  .intro h1 { margin: 0; text-align: left; font-size: clamp(1.6rem, 4vw, 2.2rem); letter-spacing: .02em; color: var(--accent); }
  .intro p { margin-top: .5rem; }
  .portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    max-width: 12rem;
    border: 1px solid var(--accent);
    border-radius: 12px;
  }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .portrait::after {
    content: "";
    position: absolute;
    inset: 0 0 -7px 0;
    background: repeating-linear-gradient(transparent 0, rgba(127, 233, 201, .12) 3.5px, transparent 7px);
    pointer-events: none;
    animation: scan 1.4s linear infinite;
  }
  @keyframes scan { to { transform: translateY(-7px); } }
  @media (prefers-reduced-motion: reduce) { .portrait::after { animation: none; } }
  .role { opacity: .7; }
  .print-only { display: none; }
  .projects { list-style: none; padding: 0; display: grid; gap: 1rem; margin-top: 1rem; }
  .projects h3 { font-size: 1.05rem; }
  .projects p { opacity: .8; font-size: .95rem; }
  @media print {
    .print-only { display: block; margin-top: .75rem; font-size: .85rem; }
    .body { display: grid; grid-template-columns: 1.1fr 1fr; gap: 0 1.75rem; }
    .projects { gap: .6rem; margin-top: .5rem; }
    .projects h3 { font-size: 1rem; }
    .projects p { font-size: .85rem; opacity: 1; }
  }
  .download { display: inline-block; border: 1px solid var(--accent); border-radius: 6px; padding: .4rem .9rem; text-decoration: none; transition: background .3s; }
  .download:hover { background: rgba(127, 233, 201, .15); }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
</style>
