---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import CardFan from "../components/CardFan.astro";
import cv from "../data/cv.json";

const posts = (await getCollection("blog", p => !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Base title="Home">
  <section id="home" class="hero">
    <h1 class="type" data-text={cv.name} aria-label={cv.name}>{cv.name}</h1>
    <p>{cv.title}. {cv.summary}</p>
    <a class="cta" href="#projects">See my work ↓</a>
  </section>

  <CardFan />

  <section id="cv" class="block reveal">
    <h2>CV</h2>
    <p>{cv.summary}</p>
    <p class="skills">{cv.skills.join(" · ")}</p>
    <p><a href="/cv">Full CV →</a></p>
  </section>

  <section id="blog" class="block reveal">
    <h2>Latest posts</h2>
    <ul>
      {posts.map(p => (
        <li><a href={`/blog/${p.id}`}>{p.data.title}</a> <small>{p.data.date.toISOString().slice(0, 10)}</small></li>
      ))}
    </ul>
    <p><a href="/blog">All posts →</a></p>
  </section>

  <section id="contact" class="block reveal">
    <h2>Contact</h2>
    <p><a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a></p>
    <p><a href={cv.contact.github}>GitHub</a></p>
  </section>
</Base>

<script>
  // type the name out once, with a blinking cursor
  const h1 = document.querySelector<HTMLElement>(".type")!;
  const text = h1.dataset.text!;
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    h1.textContent = "";
    let i = 0;
    const tick = () => {
      h1.textContent = text.slice(0, ++i);
      if (i < text.length) setTimeout(tick, 90);
    };
    setTimeout(tick, 400);
  }
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 6rem 1rem 2rem;
    text-align: center;
  }
  .type::after { content: "▌"; color: var(--accent); margin-left: .1em; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero p { max-width: 32rem; opacity: .8; }
  .cta { text-decoration: none; border: 1px solid var(--accent); border-radius: 6px; padding: .6rem 1.2rem; transition: background .3s; }
  .cta:hover { background: rgba(127, 233, 201, .15); }
  ul { list-style: none; padding: 0; margin-bottom: 1rem; }
  li { margin-bottom: .5rem; }
  small { opacity: .6; margin-left: .5rem; }
  .skills { opacity: .7; margin-bottom: 1rem; }
</style>
