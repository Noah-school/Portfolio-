---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import CardFan from "../components/CardFan.astro";
import Timeline from "../components/Timeline.astro";
import TechGrid from "../components/TechGrid.astro";
import cv from "../data/cv.json";

const posts = (await getCollection("blog", p => !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Base title="Home">
  <section id="home" class="hero">
    <h1 class="type" data-text={cv.name} aria-label={cv.name}>{cv.name}</h1>
    <p class="role">{cv.title}</p>
    <p>{cv.tagline}</p>
    <div class="actions">
      <a class="cta primary" href="#contact">Get in touch</a>
      <a class="cta" href="#projects">See my work ↓</a>
    </div>
  </section>

  <CardFan />

  <section id="cv" class="block wide">
    <h2 class="reveal">About &amp; CV</h2>
    <p class="lead reveal">{cv.summary}</p>
    <Timeline only="study" />
    <h3 class="sub reveal">Skills</h3>
    <TechGrid />
    <p class="reveal"><a href="/cv">Full CV →</a></p>
  </section>

  <section id="blog" class="block reveal">
    <h2>Latest posts</h2>
    <ul>
      {posts.map(p => (
        <li><a href={`/blog/${p.id}`}>{p.data.title}</a> <small>{p.data.date.toISOString().slice(0, 10)}</small></li>
      ))}
    </ul>
    <p><a href="/blog">All posts →</a></p>
  </section>

  <section id="contact" class="block reveal contact">
    <h2>Let's talk</h2>
    <p class="lead">Looking for an internship or a team to learn with? Send me a message.</p>
    <a class="cta primary" href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
    <p class="links"><a href={cv.contact.linkedin}>LinkedIn</a> · <a href={cv.contact.github}>GitHub</a></p>
  </section>
</Base>

<script>
  // type the name out once, with a blinking cursor
  const h1 = document.querySelector<HTMLElement>(".type")!;
  const text = h1.dataset.text!;
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    h1.textContent = "";
    let i = 0;
    const tick = () => {
      h1.textContent = text.slice(0, ++i);
      if (i < text.length) setTimeout(tick, 90);
    };
    setTimeout(tick, 400);
  }
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 6rem 1rem 2rem;
    text-align: center;
  }
  .type::after { content: "▌"; color: var(--accent); margin-left: .1em; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero p { max-width: 32rem; opacity: .8; }
  .hero .role { font-size: 1.3rem; opacity: 1; color: var(--accent); }
  .actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: .5rem; }
  .cta { text-decoration: none; border: 1px solid var(--accent); border-radius: 6px; padding: .6rem 1.2rem; transition: background .3s; }
  .cta:hover { background: rgba(127, 233, 201, .15); }
  .primary { background: var(--accent); color: #000; font-weight: bold; }
  .primary:hover { background: #fff; }
  .wide { max-width: 56rem; }
  .lead { font-size: 1.15rem; line-height: 1.8; max-width: 40rem; margin-bottom: 1.5rem; }
  .sub { color: var(--accent); margin: 2.5rem 0 1.25rem; letter-spacing: .05em; }
  .contact { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .contact .lead { margin: 0; }
  ul { list-style: none; padding: 0; margin-bottom: 1rem; }
  li { margin-bottom: .5rem; }
  small { opacity: .6; margin-left: .5rem; }
</style>
