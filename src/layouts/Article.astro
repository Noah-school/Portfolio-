---
import Base from "./Base.astro";

interface Props {
  title: string;
  meta?: string[];
  description?: string;
  image?: string;
  tags?: string[];
  tagHref?: string;
  headings: { depth: number; slug: string; text: string }[];
  back: { href: string; label: string };
}
const { title, meta = [], description, image, tags = [], tagHref, headings, back } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={title} description={description} image={image} type="article">
  <div class:list={["layout", { "no-toc": toc.length <= 1 }]}>
    <main class="post-page">
      {meta.length > 0 && <p class="meta">{meta.map(m => <span>{m}</span>)}</p>}
      <h1>{title}</h1>
      {description && <p class="summary">{description}</p>}
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map(t => <li>{tagHref ? <a href={`${tagHref}${encodeURIComponent(t)}`}>{t}</a> : <span>{t}</span>}</li>)}
        </ul>
      )}
      <slot name="before" />
      <article><slot /></article>
      <p class="back"><a href={back.href}>{back.label}</a></p>
    </main>
    {toc.length > 1 && (
      <aside class="toc" aria-label="Table of contents">
        <p>On this page</p>
        <ol>
          {toc.map(h => <li class:list={{ sub: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </aside>
    )}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLPreElement>("article pre.astro-code").forEach(pre => {
    const btn = document.createElement("button");
    btn.className = "copy";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.innerText);
      btn.textContent = "Copied";
      setTimeout(() => (btn.textContent = "Copy"), 1500);
    });
    pre.append(btn);
  });

  const diagrams = [...document.querySelectorAll<HTMLElement>("article code.language-mermaid")];
  if (diagrams.length) {
    const { default: mermaid } = await import("mermaid");
    mermaid.initialize({
      startOnLoad: false,
      theme: "dark",
      themeVariables: { primaryColor: "#10241f", primaryBorderColor: "#7fe9c9", lineColor: "#7fe9c9", fontFamily: "ui-monospace, monospace" },
    });
    for (const code of diagrams) {
      const div = document.createElement("div");
      div.className = "mermaid";
      div.textContent = code.textContent;
      code.closest("pre")!.replaceWith(div);
    }
    await mermaid.run({ querySelector: "article .mermaid" });
  }
</script>

<style is:global>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 46rem) 14rem;
    justify-content: center;
    gap: 3rem;
    padding: 6rem 1rem 4rem;
  }
  .layout.no-toc { grid-template-columns: minmax(0, 46rem); }
  @media (max-width: 1100px) { .layout { grid-template-columns: minmax(0, 46rem); } .toc { display: none; } }

  .post-page h1 { font-size: clamp(1.8rem, 5vw, 3rem); text-align: left; margin: .25rem 0 1rem; }
  .post-page .meta { display: flex; gap: 1rem; font-size: .8rem; opacity: .55; letter-spacing: .04em; }
  .post-page .tags { list-style: none; padding: 0; display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .post-page .summary { font-size: 1.1rem; opacity: .8; margin-bottom: 1rem; }
  .post-page .tags a, .post-page .tags span {
    font-size: .72rem;
    text-decoration: none;
    border: 1px solid rgba(127, 233, 201, .35);
    border-radius: 999px;
    padding: .05rem .6rem;
    color: var(--accent);
  }

  article > * + * { margin-top: 1rem; }
  article h2 { margin-top: 2.5rem; color: var(--accent); scroll-margin-top: 5rem; }
  article h3 { margin-top: 1.75rem; scroll-margin-top: 5rem; }
  article ul, article ol { padding-left: 1.5rem; }
  article :not(pre) > code { color: var(--accent); background: rgba(127, 233, 201, .08); padding: .05rem .3rem; border-radius: 4px; }
  article pre.astro-code {
    position: relative;
    padding: 1rem;
    border: 1px solid rgba(127, 233, 201, .2);
    border-radius: 10px;
    overflow-x: auto;
    background: #0a0f0e !important;
    font-size: .85rem;
  }
  article pre .copy {
    position: absolute;
    top: .5rem;
    right: .5rem;
    font: inherit;
    font-size: .7rem;
    color: #fff;
    background: rgba(255, 255, 255, .08);
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 6px;
    padding: .1rem .5rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity .2s;
  }
  article pre:hover .copy, article pre .copy:focus-visible { opacity: 1; }
  article .mermaid { display: flex; justify-content: center; padding: 1rem; border: 1px solid rgba(127, 233, 201, .2); border-radius: 10px; }
  article img { display: block; max-width: 100%; height: auto; margin-inline: auto; border-radius: 10px; }
  article blockquote { border-left: 2px solid var(--accent); padding-left: 1rem; opacity: .85; }
  .post-page .back { margin-top: 3rem; }

  .toc { position: sticky; top: 6rem; align-self: start; font-size: .8rem; }
  .toc p { text-transform: uppercase; letter-spacing: .1em; opacity: .5; margin-bottom: .75rem; }
  .toc ol { list-style: none; padding: 0; border-left: 1px solid rgba(255, 255, 255, .15); }
  .toc li a { display: block; padding: .25rem 0 .25rem 1rem; color: #fff; opacity: .6; text-decoration: none; transition: opacity .3s, color .3s; }
  .toc li.sub a { padding-left: 2rem; }
  .toc li a:hover { opacity: 1; color: var(--accent); }
</style>
