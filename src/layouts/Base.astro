---
import "../styles/global.css";
import Backdrop from "../components/Backdrop.astro";
import cv from "../data/cv.json";

interface Props { title: string; description?: string; image?: string; type?: "website" | "article" }
const {
  title,
  description = `${cv.name}, ${cv.title.toLowerCase()}. ${cv.tagline}`,
  image = "/og.png",
  type = "website",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: cv.name,
  jobTitle: cv.title,
  url: Astro.site,
  sameAs: [cv.contact.github, cv.contact.linkedin],
};
const links = [
  { href: "/#home", label: "Home", id: "home" },
  { href: "/#projects", label: "Projects", id: "projects" },
  { href: "/#cv", label: "About", id: "cv" },
  { href: "/#blog", label: "Blog", id: "blog" },
  { href: "/#contact", label: "Contact", id: "contact" },
];
// on the standalone pages the matching nav link is highlighted by path
const current = Astro.url.pathname.split("/")[1];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} · Noah Verstraeten</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={cv.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  {Astro.url.pathname === "/" && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  <link rel="alternate" type="application/rss+xml" title="Blog" href="/rss.xml">
  <script is:inline>document.documentElement.classList.add("js")</script>
</head>
<body>
  <Backdrop />
  <div class="progress" id="progress"></div>
  <nav>
    {links.map(l => <a href={l.href} data-id={l.id} aria-current={l.id === current ? "page" : undefined}>{l.label}</a>)}
  </nav>
  <slot />
</body>
</html>

<script>
  const bar = document.getElementById("progress")!;
  const setBar = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };
  addEventListener("scroll", setBar, { passive: true });
  setBar();

  const io = new IntersectionObserver(entries => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
  }, { threshold: .15 });
  document.querySelectorAll(".reveal").forEach(el => io.observe(el));

  const root = document.documentElement;
  const unfreeze = () => {
    if (!root.classList.contains("jump")) return;
    root.classList.remove("jump");
    dispatchEvent(new Event("fan:unlock"));
  };
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]').forEach(a => {
    a.addEventListener("click", () => {
      const target = document.getElementById(a.hash.slice(1));
      const fan = document.getElementById("projects");
      if (location.pathname !== "/" || !target || !fan) return;
      const after = target.getBoundingClientRect().top > fan.getBoundingClientRect().top + 1;
      root.classList.add("jump");
      dispatchEvent(new CustomEvent("fan:lock", { detail: after ? "last" : "first" }));
      setTimeout(unfreeze, 2500);
    });
  });
  addEventListener("scrollend", unfreeze);
  addEventListener("wheel", unfreeze, { passive: true });
  addEventListener("touchstart", unfreeze, { passive: true });

  const links = [...document.querySelectorAll<HTMLAnchorElement>("nav a")];
  const spy = new IntersectionObserver(entries => {
    for (const e of entries) if (e.isIntersecting)
      links.forEach(l => l.toggleAttribute("aria-current", l.dataset.id === e.target.id));
  }, { rootMargin: "-45% 0px -50% 0px" });
  document.querySelectorAll("section[id]").forEach(el => spy.observe(el));
</script>

<style is:global>
  @page { size: A4; margin: 12mm 14mm; }
  @media print {
    html { font-size: 10.5px; }
    :root { --accent: #0b6e5a; }
    .timeline li { padding-bottom: .6rem !important; }
    .group { margin-bottom: .9rem !important; }
    .group ul { grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr)) !important; gap: .35rem !important; }
    .group li { min-height: 3.6rem !important; padding: .4rem .25rem !important; }
    .group li svg { height: 1.2rem !important; max-width: 3.4rem !important; }
    .group li { gap: .3rem !important; }
    h2, h3 { break-after: avoid; }
    li, .intro { break-inside: avoid; }
    body { background: #fff; color: #000; min-height: 0; }
    nav, .progress, #backdrop, .spot, .no-print, .portrait::after { display: none !important; }
    .js .reveal { opacity: 1 !important; transform: none !important; }
    a { color: #000; }
    main.page { padding: 0 !important; margin: 0 auto !important; max-width: none !important; }
    main.page h2 { margin-top: 1.25rem !important; }
  }

  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  .jump .card { transition: none !important; }

  nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: .85rem;
    background: linear-gradient(#000 40%, transparent);
  }
  nav a { color: #fff; text-decoration: none; opacity: .6; transition: opacity .3s, color .3s; }
  nav a:hover, nav a[aria-current] { opacity: 1; color: var(--accent); }

  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 11;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .js .reveal { opacity: 0; transform: translateY(2rem); transition: opacity .9s ease, transform .9s ease; }
  .js .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .js .reveal { opacity: 1; transform: none; transition: none; } }

  main.page { max-width: 46rem; margin: 0 auto; padding: 6rem 1rem 4rem; }
  section.block { max-width: 46rem; margin: 0 auto; padding: 6rem 1rem; min-height: 60vh; scroll-margin-top: 2rem; }
  section.block h2 { color: var(--accent); margin-bottom: 1rem; letter-spacing: .05em; }
</style>
